# Database
DATABASE_URL="postgresql://user:password@localhost:5432/savit?schema=public"

# JWT Secret (generate a strong random string for production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Field-level encryption (used to encrypt data stored in DB)
ENCRYPTION_KEY="change-me-to-a-strong-32+-char-secret"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
