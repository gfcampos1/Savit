# =====================================================================
# SAVIT — Environment Variables
# Copy this to .env for local dev. Railway uses its own Variables panel.
# =====================================================================

# === Database ===
# Local: usar docker compose up -d postgres (porta 5433 por padrão).
# Railway: o add-on Postgres preenche DATABASE_URL automaticamente.
DATABASE_URL="postgresql://savit:savit@localhost:5433/savit?schema=public"

# === Server ===
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# === Auth (JWT + refresh) ===
# Gerar com: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-chars-locally
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# === Field-level encryption (futuro: BYOK) ===
# Gerar com: openssl rand -base64 48 (32+ chars)
ENCRYPTION_KEY=change-me-to-at-least-32-random-chars

# === Cloudflare R2 (storage) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=savit-attachments
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
R2_REGION=auto

# === OpenRouter (chat IA + transcrição) ===
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
OPENROUTER_FALLBACK_MODEL=openai/gpt-5
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=Savit
WHISPER_MODEL=openai/whisper-large-v3

# === Rate limits IA (por usuário) ===
AI_DAILY_TOKEN_LIMIT=200000
AI_MONTHLY_TOKEN_LIMIT=2000000
AI_DAILY_AUDIO_MINUTES=60

# === Cron (weekly summary) ===
CRON_SECRET=change-me-cron-shared-secret

# === Observabilidade (opcional) ===
SENTRY_DSN=
LOG_LEVEL=info

# === Frontend (Vite — prefixo VITE_ pra expor no client) ===
VITE_API_URL=http://localhost:3001
VITE_PUBLIC_R2_BASE=https://pub-xxxxx.r2.dev
VITE_SENTRY_DSN=
