# =====================================================================
# SAVIT — Environment Variables
# Copy this to .env for local dev. Railway uses its own Variables panel.
# =====================================================================

# === Database ===
# Local: usar docker compose up -d postgres (porta 5433 por padrão).
# Railway: o add-on Postgres preenche DATABASE_URL automaticamente.
DATABASE_URL="postgresql://savit:savit@localhost:5433/savit?schema=public"

# === Server ===
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# === Auth (JWT + refresh) ===
# Gerar com: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-chars-locally
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# === Field-level encryption (futuro: BYOK) ===
# Gerar com: openssl rand -base64 48 (32+ chars)
ENCRYPTION_KEY=change-me-to-at-least-32-random-chars

# === Cloudflare R2 (storage) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=savit-attachments
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
R2_REGION=auto

# === OpenRouter (chat IA) ===
# Voz é transcrita pelo navegador (Web Speech API), não usa OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
OPENROUTER_FALLBACK_MODEL=openai/gpt-5
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=Savit

# === Rate limits IA (por usuário) ===
AI_DAILY_TOKEN_LIMIT=200000
AI_MONTHLY_TOKEN_LIMIT=2000000

# === Cron (weekly summary, trial expirer) ===
CRON_SECRET=change-me-cron-shared-secret

# === Google OAuth (login com Google) ===
# Criar em https://console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth Client ID (type Web). Authorized JavaScript origins:
#   http://localhost:5173 (dev) + https://seu-dominio.up.railway.app (prod)
GOOGLE_OAUTH_CLIENT_ID=

# === Admin único via env ===
# Boot do API faz upsert(role=ADMIN) com essas credenciais. Mudar a senha
# aqui e re-deployar = rotação. Deixe vazio se não quiser admin agora.
ADMIN_EMAIL=
ADMIN_PASSWORD=                        # mín 12 chars, hashed com bcrypt
ADMIN_NAME=Admin

# === Asaas (pagamentos BR — Pix + cartão recorrente + boleto) ===
# Sandbox: https://sandbox.asaas.com — pegue API key + webhook token no painel.
# Produção: troque ASAAS_BASE_URL pra https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=                   # token configurado em Configurações → Notificações

# === Planos (centavos) ===
PLAN_MONTHLY_PRICE_BRL=1990            # R$ 19,90/mês
PLAN_YEARLY_PRICE_BRL=19900            # R$ 199,00/ano (~17% desconto)
TRIAL_DAYS=14

# === Observabilidade (opcional) ===
SENTRY_DSN=
LOG_LEVEL=info

# === Frontend (Vite — prefixo VITE_ pra expor no client) ===
VITE_API_URL=http://localhost:3001
VITE_PUBLIC_R2_BASE=https://pub-xxxxx.r2.dev
VITE_SENTRY_DSN=
# Deve ser igual a GOOGLE_OAUTH_CLIENT_ID (mesmo valor, exposto no front pro GIS)
VITE_GOOGLE_CLIENT_ID=
