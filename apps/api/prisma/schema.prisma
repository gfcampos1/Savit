// Savit — Prisma schema
// Cobertura completa do plano (notas, tarefas, kanban, chat IA, anexos R2, etc.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Auth
// =====================================================================

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIALING // dentro dos 14 dias
  ACTIVE // pagou, dentro do período corrente
  PAST_DUE // pagamento atrasado (cartão recusou, boleto vencido)
  CANCELED // cancelou — fica ativo até currentPeriodEndsAt
  BLOCKED // trial expirado sem pagar OU CANCELED + período expirou
}

enum SubscriptionPlan {
  PRO_MONTHLY
  PRO_YEARLY
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String? // nullable: usuários só-Google não têm senha
  name         String?
  googleId     String? @unique
  avatarUrl    String?
  role         UserRole @default(USER)

  // Billing
  plan                SubscriptionPlan?
  status              SubscriptionStatus @default(TRIALING)
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  asaasCustomerId     String?            @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  categories     Category[]
  notes          Note[]
  tasks          Task[]
  recurringTasks RecurringTask[]
  threads        ChatThread[]
  attachments    Attachment[]
  weekly         WeeklySummary[]
  aiUsage        AiUsage[]
  subscriptions  Subscription[]
  billingEvents  BillingEvent[]
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String
  asaasSubscriptionId String             @unique
  plan                SubscriptionPlan
  status              SubscriptionStatus
  startedAt           DateTime           @default(now())
  endedAt             DateTime?
  cancelReason        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BillingEvent {
  id             String   @id @default(cuid())
  userId         String
  asaasPaymentId String?
  type           String // ex: PAYMENT_CONFIRMED, PAYMENT_OVERDUE, SUBSCRIPTION_DELETED
  status         String?
  amount         Decimal? @db.Decimal(10, 2)
  payload        Json     // body bruto do webhook pra debug
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([asaasPaymentId])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  hashedToken String    @unique
  deviceInfo  String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =====================================================================
// Domain
// =====================================================================

model Category {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String   // hex da paleta da SPEC §1.5
  icon      String?
  sortOrder Int       @default(0)
  // slug != null marca categoria fixa do sistema (ex: 'books', 'youtube').
  // Categorias fixas não podem ser deletadas — apenas ocultadas via hiddenAt.
  slug      String?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes          Note[]
  tasks          Task[]
  recurringTasks RecurringTask[]

  @@unique([userId, name])
  @@unique([userId, slug])
  @@index([userId])
}

enum NoteType {
  TEXT
  VOICE
  DRAWING
  MINDMAP
  PHOTO
  MIXED
}

model Note {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String?
  type        NoteType  @default(TEXT)
  title       String?
  contentJson Json? // TipTap doc, tldraw snapshot, mindmap nodes/edges
  contentText String? // texto extraído pra busca FTS
  rawInput    String? // texto cru do composer (pré-parser)
  priority    String? // low | med | high
  // Payload livre por slug de categoria fixa (BookMeta, YoutubeMeta) — validado
  // no handler com base em category.slug. Nulo para categorias do usuário.
  metadata    Json?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Coluna gerada pra full-text search PT-BR (criada via migration manual
  // 20260502190000_note_fts). Marcada como Unsupported pra Prisma não tentar
  // alterar/dropar; é write-once via expressão STORED.
  ftsTextPt Unsupported("tsvector")?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  tasks       Task[]

  @@index([userId, createdAt])
  @@index([categoryId])
}

enum AttachmentKind {
  PHOTO
  AUDIO
  DRAWING_EXPORT
  FILE
}

model Attachment {
  id            String         @id @default(cuid())
  noteId        String?
  userId        String
  kind          AttachmentKind
  r2Key         String         @unique // path no bucket: userId/noteId/uuid.ext
  mimeType      String
  sizeBytes    Int
  durationMs    Int? // pra audio
  transcription String? // pra audio
  meta          Json? // dimensões, etc.
  uploadedAt    DateTime?
  createdAt     DateTime       @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([noteId])
}

enum TaskStatus {
  TODAY
  UPCOMING
  SOMEDAY
  DONE
  ARCHIVED
}

model Task {
  id                String     @id @default(cuid())
  userId            String
  noteId            String? // origem opcional
  categoryId        String?
  recurringTaskId   String? // origem: instância de uma RecurringTask
  title             String
  description       String? // markdown curto
  status            TaskStatus @default(TODAY)
  column            String     @default("hoje") // coluna kanban configurável
  sortOrder         Int        @default(0)
  dueAt             DateTime?
  priority          String? // low | med | high
  reminderMinBefore Int?
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  note          Note?          @relation(fields: [noteId], references: [id], onDelete: SetNull)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTask RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  @@index([userId, status, column, sortOrder])
  @@index([userId, dueAt])
  @@index([recurringTaskId])
}

// Template + cadência de tarefa recorrente (apenas semanal por enquanto).
// Job diário (POST /api/jobs/recurring-tasks) instancia novas Tasks na coluna
// 'sem-prazo' (= backlog) toda vez que nextRunAt vence, e avança +7 dias.
model RecurringTask {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String?
  title       String
  description String?
  priority    String? // low | med | high
  weekday     Int // 0=domingo..6=sábado
  isActive    Boolean   @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks    Task[]

  @@index([userId, isActive, nextRunAt])
  @@index([categoryId])
}

// =====================================================================
// Chat IA
// =====================================================================

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  model     String   @default("anthropic/claude-sonnet-4-6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id           String     @id @default(cuid())
  threadId     String
  role         ChatRole
  content      String     @db.Text
  toolCalls    Json? // chamadas de tool feitas pelo modelo
  toolResult   Json? // resultado das tools que rodamos
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime   @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  audioSeconds Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, model])
  @@index([userId, date])
}

// =====================================================================
// Weekly digest
// =====================================================================

model WeeklySummary {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  payload   Json
  text      String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}
