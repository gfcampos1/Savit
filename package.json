{
  "name": "savit",
  "version": "1.0.0",
  "description": "App de ideias e notas - Salve suas ideias como mensagens para você mesmo",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "icons:generate": "node scripts/generate-icons.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:encrypt-existing": "node prisma/encrypt-existing.js",
    "postinstall": "prisma generate && node scripts/copy-fontawesome.js"
  },
  "keywords": [
    "notes",
    "ideas",
    "todo",
    "tasks"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mind-elixir": "^5.5.0",
    "pino": "^10.1.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.7.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "sanitize-html": "^2.17.0",
    "speakeasy": "^2.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
